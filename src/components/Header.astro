---
const links = [
  { href: "/", label: "Home" },
  { href: "/learn", label: "Learn" },
  { href: "/about", label: "About" },
];
---

<header class="border-b border-wax-coat-tan bg-pale-cream">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
    <a href="/" class="font-display text-xl font-bold text-aged-rind-brown"
      >String Cheese</a
    >
    <ul class="flex gap-6">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-body text-aged-rind-brown hover:text-string-pull-red"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
